# 카카오맵 JavaScript SDK 앱키 (https://developers.kakao.com > 내 애플리케이션 > JavaScript 키)
# 넣으면 /search, 매물 상세 페이지의 지도가 자동으로 실제 지도로 바뀐다. 없으면 플레이스홀더 노출.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# 공공데이터포털(data.go.kr) "건축물대장정보 서비스"(BldRgstService_v2) 인증키.
# 넣으면 매물에 buildingCode가 채워진 경우 실제 건축물대장 정보를 조회한다. 없으면 목업 값 사용.
DATA_GO_KR_BUILDING_REGISTRY_KEY=

# 상담문의/매물의뢰 폼 제출 시 알림 보낼 웹훅 URL (예: 슬랙 Incoming Webhook).
# 넣으면 폼 제출마다 이 URL로 알림을 전송한다. 없으면 서버 콘솔에만 로그 남김.
CONTACT_WEBHOOK_URL=
